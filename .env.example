# =====================================================================
#  MiMascota - Variables de entorno
#  Copia este archivo como .env y completa los valores vacíos.
#  Los valores de host/puerto están pensados para ejecutar el backend
#  localmente; docker-compose los sobrescribe para la red interna.
# =====================================================================

# ---------- Aplicación ----------
APP_NAME="MiMascota API"
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
# Lista JSON de orígenes permitidos por CORS
CORS_ORIGINS='["http://localhost:5173"]'
BACKEND_PORT=8000

# ---------- Seguridad (JWT) ----------
# Obligatorio. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------- PostgreSQL ----------
POSTGRES_USER=mimascota
# Obligatorio
POSTGRES_PASSWORD=
POSTGRES_DB=mimascota
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- MongoDB (replica set) ----------
MONGO_REPLICA_SET_NAME=rs0
MONGO_DB=mimascota
# Desde el host se usa conexión directa al nodo mongo1 (puerto 27017).
# Dentro de Docker el backend usa la URI completa del replica set.
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
# Obligatorio
REDIS_PASSWORD=
REDIS_DB=0
SEARCH_CACHE_TTL_SECONDS=300

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/notificaciones
# true: datos simulados en el navegador (sin backend); false: API real
VITE_USE_MOCK=false

# ---------- Respaldos ----------
BACKUP_DIR=./backups
