# =====================================================================
#  MiMascota - Variables de entorno
#  Copie este archivo como .env (cp .env.example .env) y complete los
#  valores marcados como obligatorios.
#  Los valores de host están pensados para ejecutar el backend en local;
#  docker-compose los sobrescribe para la red interna de Docker.
# =====================================================================

# ---------- Aplicación ----------
APP_NAME="MiMascota API"
APP_ENV=development
# Prefijo de la API REST (el frontend usa VITE_API_URL=http://localhost:8000/api)
API_PREFIX=/api
# Lista JSON de orígenes permitidos por CORS
CORS_ORIGINS='["http://localhost:5173","http://127.0.0.1:5173"]'
BACKEND_PORT=8000

# ---------- Seguridad (JWT) ----------
# Obligatorio. Genere uno con: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ---------- MongoDB (replica set rs0) ----------
MONGO_REPLICA_SET_NAME=rs0
MONGO_DB=mimascota
# Desde el equipo anfitrión se usa conexión directa al nodo mongo1 (puerto 27017).
# Dentro de Docker el backend usa la URI completa del replica set.
MONGO_URI=mongodb://localhost:27017/?directConnection=true

# ---------- Frontend ----------
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000/api
VITE_WS_URL=ws://localhost:8000/ws/notificaciones
# true: datos simulados en el navegador (sin backend); false: datos reales de MongoDB
VITE_USE_MOCK=false

# ---------- Respaldos ----------
BACKUP_DIR=./backups
