# =====================================================================
#  MiMascota - .gitignore
# =====================================================================

# ---------- Variables de entorno (NUNCA subir secretos) ----------
.env
.env.*
!.env.example
*.env.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
eggs/
.eggs/
*.egg-info/
*.egg
pip-wheel-metadata/
.installed.cfg

# Entornos virtuales
venv/
.venv/
env/
ENV/
.python-version

# Pruebas y cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/
.nox/
.hypothesis/

# Herramientas de análisis
.mypy_cache/
.ruff_cache/
.dmypy.json
.pyre/

# Jupyter
.ipynb_checkpoints/

# ---------- Node / React / Vite ----------
node_modules/
frontend/dist/
frontend/dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.eslintcache
.npm/

# ---------- Logs ----------
logs/
*.log

# ---------- Respaldos de bases de datos ----------
backups/
*.dump
*.backup
*.archive
*.bson
*.sql.gz

# ---------- Docker (volúmenes y datos locales) ----------
docker-data/
data/
volumes/
mongo-data/
postgres-data/
redis-data/
*.rdb
appendonly.aof
appendonlydir/
docker-compose.override.yml

# ---------- Sistema operativo ----------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
.directory

# ---------- Editores e IDEs ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*.sublime-project
*.sublime-workspace
.history/
