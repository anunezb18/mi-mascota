# URL base de la API REST de MiMascota (FastAPI)
VITE_API_URL=http://localhost:8000/api
# URL del WebSocket de notificaciones en tiempo real
VITE_WS_URL=ws://localhost:8000/ws/notificaciones
# true: usa datos simulados en el navegador (no requiere backend)
# false: consume la API real
VITE_USE_MOCK=true
